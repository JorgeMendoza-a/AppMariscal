rules_version = '2';
// Reglas de seguridad de Firestore para Mariscal Shop.
// Copia todo este archivo en: Firebase Console → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Perfiles: cada quien ve y edita el suyo, pero NO puede cambiarse el rol.
    // Solo un administrador puede ver a todos y dar/quitar el rol de admin.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'student';
      allow update: if isAdmin()
        || (request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Productos: todos los usuarios con sesión los ven; solo admins los modifican.
    match /products/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Ajustes de la tienda (WhatsApp, costo de entrega…)
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Pedidos: el cliente crea y ve los suyos y puede cancelar uno pendiente.
    // El administrador ve todos y cambia su estado.
    match /orders/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pendiente'
        && request.resource.data.stockApplied == false;
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.uid == request.auth.uid
            && resource.data.status == 'pendiente'
            && request.resource.data.status == 'cancelado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isAdmin();
    }
  }
}
